<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="frontend.infobar.InfobarController"
      spacing="20.0"
      style="-fx-background-radius: 20px; -fx-background-color: #f0f0f0;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Welcome to Infobar!"
           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #673AB7; -fx-alignment: center" />

    <Button fx:id="clickBtn"
            text="Click me!"
            onAction="#update"
            style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-padding: 8px 16px;"/>

</VBox>
